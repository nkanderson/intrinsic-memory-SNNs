        <mxCell id="pm-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=1;" value="Linear Layer &amp;mdash; Parallel-MAC Calculation" vertex="1">
          <mxGeometry height="24" width="800" x="140" y="8" as="geometry" />
        </mxCell>
        <mxCell id="pm-2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" value="P MAC engines work in lockstep &amp;middot; 1 input broadcasts per cycle &amp;middot; P weights read in parallel &amp;middot; &amp;lceil;N_out / P&amp;rceil; batches per layer" vertex="1">
          <mxGeometry height="18" width="800" x="140" y="36" as="geometry" />
