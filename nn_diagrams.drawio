        <mxCell id="pm-3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" value="Reading a snapshot: column headers x[0..3] are the input vector; the highlighted (blue) x[T] is broadcast this cycle. Each orange cell w[n,T] = one MAC engine&amp;rsquo;s multiply this cycle." vertex="1">
